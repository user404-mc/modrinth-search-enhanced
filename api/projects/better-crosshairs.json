  "body": "<p align=\"center\">\n  <a href=\"https://raw.githubusercontent.com/genizy/Better-Crosshairs/refs/heads/master/image.png\">\n    <img src=\"https://raw.githubusercontent.com/genizy/Better-Crosshairs/refs/heads/master/image.png\" width=\"180\" style=\"border-radius: 12px;\" />\n  </a>\n</p>\n<h1 align=\"center\">Better Crosshairs</h1>\n<p align=\"center\"><em>A great Fabric mod for better crosshair customization.</em></p>\n<hr />\n<table width=\"100%\" style=\"width: 100%; border-collapse: collapse;\">\n  <tr>\n    <td width=\"70%\" valign=\"top\" style=\"padding-right: 16px;\">\n      <h3>Customizable colors</h3>\n      <ul>\n        <li>Colors the crosshair of your choice, uses hex code to pick from</li>\n      </ul>\n    </td>\n    <td width=\"30%\" align=\"right\" valign=\"top\">\n      <a href=\"https://github.com/genizy/Better-Crosshairs/blob/master/screenshots/greencursor.png?raw=true\">\n        <img src=\"https://github.com/genizy/Better-Crosshairs/blob/master/screenshots/greencursor.png?raw=true\" width=\"220\" style=\"border-radius: 8px; display: block;\" />\n      </a>\n    </td>\n  </tr>\n  <tr>\n    <td width=\"70%\" valign=\"top\" style=\"padding-right: 16px;\">\n      <h3>Custom scaling</h3>\n      <ul>\n        <li>Scales the crosshair of your choice, with 1-64px to choose from</li>\n      </ul>\n    </td>\n    <td width=\"30%\" align=\"right\" valign=\"top\">\n      <a href=\"https://github.com/genizy/Better-Crosshairs/blob/master/screenshots/giantgreencursor.png?raw=true\">\n        <img src=\"https://github.com/genizy/Better-Crosshairs/blob/master/screenshots/giantgreencursor.png?raw=true\" width=\"220\" style=\"border-radius: 8px; display: block;\" />\n      </a>\n    </td>\n  </tr>\n  <tr>\n    <td width=\"70%\" valign=\"top\" style=\"padding-right: 16px;\">\n      <h3>Custom sprites</h3>\n      <ul>\n        <li>Uses either, url, file or minecraft identifier for custom sprites</li>\n      </ul>\n    </td>\n    <td width=\"30%\" align=\"right\" valign=\"top\">\n      <a href=\"https://raw.githubusercontent.com/genizy/Better-Crosshairs/refs/heads/master/screenshots/readycursor.png\">\n        <img src=\"https://raw.githubusercontent.com/genizy/Better-Crosshairs/refs/heads/master/screenshots/readycursor.png\" width=\"220\" style=\"border-radius: 8px; display: block;\" />\n      </a>\n    </td>\n  </tr>\n  <tr>\n    <td width=\"70%\" valign=\"top\" style=\"padding-right: 16px;\">\n      <h3>Target Shading</h3>\n      <ul>\n        <li>Shades the target indicator when hovering over a user</li>\n      </ul>\n    </td>\n    <td width=\"30%\" align=\"right\" valign=\"top\">\n      <a href=\"https://github.com/genizy/Better-Crosshairs/blob/master/screenshots/graycursor.png?raw=true\">\n        <img src=\"https://github.com/genizy/Better-Crosshairs/blob/master/screenshots/graycursor.png?raw=true\" width=\"220\" style=\"border-radius: 8px; display: block;\" />\n      </a>\n    </td>\n  </tr>\n</table>\n",
