  "body": "<br>\n\n<p align=\"center\">\n  <img \n    src=\"https://cdn.modrinth.com/data/cached_images/41e59cddbc38fc7c59ff81a06443f5f0ee2eb48f.png\"\n    alt=\"Mobs Heads to Hats\"\n    width=\"600\">\n</p>\n\n<br>\n\n<hr>\n\n<br>\n\n<p align=\"center\">\n  <img \n    src=\"https://cdn.modrinth.com/data/cached_images/17aeebc13d1a3219e7e518d7a7f22a49446d7a4a_0.webp\"\n    alt=\"Description\"\n    width=\"300\">\n</p>\n\n# What have in the texturepack\n\n- Skeleton Skull: Christmas Hat\n- Wither Skeleton Skull: SnowMan Hat\n- Zombie Head: Elf Hat\n\n<h1></h1>\n\n<p align=\"center\">\n  <img \n    src=\"https://cdn.modrinth.com/data/Y15XXQHf/images/fd3215fb890d5ebe3c47d37c51afbbcb5e4ef2af.png\"\n    alt=\"Christmas Hat\"\n    style=\"max-width:100%; height:auto;\">\n</p>\n\n<p align=\"center\">\n  <img \n    src=\"https://cdn.modrinth.com/data/Y15XXQHf/images/288295847a08a33f99e320b03f6f8121063217e6.png\"\n    alt=\"SnowMan Hat\"\n    style=\"max-width:100%; height:auto;\">\n</p>\n\n<p align=\"center\">\n  <img \n    src=\"https://cdn.modrinth.com/data/Y15XXQHf/images/0f4707e3874aa49149f36439b5b87f1002fe9c34.png\"\n    alt=\"Elf Hat\"\n    style=\"max-width:100%; height:auto;\">\n</p>\n\n<h1></h1>\n\n<br>\n\n<div align=\"center\">\n\n  <img src=\"https://cdn.modrinth.com/data/cached_images/e812fd6e67e9eac3c00ba2bf16df1830cef91c82.png\"\n    alt=\"REQUIREMENTS\"\n    width=\"320\">\n\n<p>This pack requires <strong>Optifine</strong> or <strong>Entity Model Features</strong> Fabric 1.21.X, Forge 1.21.X.</p>\n  \n  <a href=\"https://modrinth.com/mod/entity-model-features\">\n    <img src=\"https://i.imgur.com/KssS6VT.png\" width=\"100\" alt=\"EMF\">\n  </a>\n  \n</div>\n\n<br>\n\n<hr>\n\n<p align=\"center\">\n  <img \n    src=\"https://cdn.modrinth.com/data/cached_images/a84a822e69f5e42576ea0631129332b714a27a0a_0.webp\"\n    alt=\"LINKS\"\n    width=\"170\">\n</p>\n\n<p align=\"center\">\n  <a href=\"https://www.curseforge.com/minecraft/texture-packs/mobs-heads-to-hats\"